{
  "name": "@local/cursor-skills",
  "private": true,
  "version": "1.1.0",
  "description": "Cursor built-in agent skills, reverse-engineered from the local Cursor.app and re-packaged as a DeepSeek Harness bundled skill provider (26 skills with Cursor→DSH tool mapping).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "skills-manifest.json",
    "dshtool-map.json",
    "skills",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cursor",
    "skills",
    "deepseek-harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnuxe/dsh-cursor.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.0-rc.2"
}
